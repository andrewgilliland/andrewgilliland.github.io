---
interface Props {
  className?: string;
}

const { className = "mt-8 h-2 w-full rounded-full" } = Astro.props;
---

<div class:list={["color-divider", className]}></div>

<style>
  /* The colour stripe under page headings, above the footer, and in the home
     intro (ColorDivider.astro). The stripes are a repeating gradient at -10deg
     on an inner layer, sized so the pattern repeats exactly once per divider
     width (100cqw): four equal bands, and every joint a regular slanted edge.
     A plain angled gradient would cut the outer bands short. */
  .color-divider {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
  }

  .color-divider::before {
    /* One period of the pattern along the gradient line; four equal bands. */
    --band: calc(100cqw * sin(10deg));
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -10deg,
      theme("colors.neon.pink") 0,
      theme("colors.neon.pink") calc(var(--band) * 0.25),
      theme("colors.neon.emerald") calc(var(--band) * 0.25),
      theme("colors.neon.emerald") calc(var(--band) * 0.5),
      theme("colors.neon.yellow") calc(var(--band) * 0.5),
      theme("colors.neon.yellow") calc(var(--band) * 0.75),
      theme("colors.neon.cyan") calc(var(--band) * 0.75),
      theme("colors.neon.cyan") var(--band)
    );
  }

  /* The home intro's stripe slides. It makes one pass on load (3s, under
     WCAG 2.2.2's 5s limit for motion without a pause control) by sliding the
     layer one period, and loops while its parent is hovered by moving the
     endlessly repeating background, so it never runs out; leaving pauses it
     in place. The two animations use different properties, so neither
     restarts. */
  .color-divider--slide::before {
    /* One extra period, for the load pass to slide across. */
    width: 200%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .color-divider--slide::before {
      animation:
        stripe-pass 3s cubic-bezier(0.2, 0.7, 0.2, 1) both,
        stripe-loop 6s linear infinite paused;
    }

    :global(:hover) > .color-divider--slide::before {
      animation-play-state: running, running;
    }
  }

  @keyframes stripe-pass {
    to {
      translate: -50% 0;
    }
  }

  @keyframes stripe-loop {
    to {
      background-position-x: -100cqw;
    }
  }
</style>

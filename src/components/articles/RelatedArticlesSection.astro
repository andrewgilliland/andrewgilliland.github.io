---
import ArticleListItemLink from "@/components/articles/ArticleListItemLink.astro";
import { toSlug } from "@/lib/slug";
import type { CollectionEntry } from "astro:content";

interface Props {
  articles: CollectionEntry<"articles">[];
}

const { articles } = Astro.props as Props;
const accents = ["cyan", "emerald", "yellow"] as const;
---

{articles.length > 0 && (
  <section class="border-t-2 border-neutral-50 pt-10">
    <h2 class="mb-6 text-2xl font-bold text-neutral-50">Related Articles</h2>
    <ul class="flex flex-col gap-5">
      {articles.map((article, index) => (
        <ArticleListItemLink
          href={`/articles/${toSlug(article.id)}`}
          title={article.data.title}
          date={article.data.date}
          accent={accents[index % accents.length]}
        />
      ))}
    </ul>
  </section>
)}

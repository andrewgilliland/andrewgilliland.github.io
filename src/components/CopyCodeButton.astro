<style is:global>
  .copy-code-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: theme("colors.neutral.300");
    background-color: theme("colors.neon.bg");
    border: 2px solid theme("colors.neutral.50");
    border-radius: 0;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      translate 0.15s ease;
  }

  pre:hover .copy-code-btn,
  .copy-code-btn:focus-visible {
    opacity: 1;
  }

  .copy-code-btn:focus-visible {
    outline: 2px solid theme("colors.neutral.50");
    outline-offset: 2px;
  }

  .copy-code-btn:hover {
    color: theme("colors.neutral.50");
    box-shadow: 3px 3px 0 0 theme("colors.neon.pink");
    translate: -2px -2px;
  }

  .copy-code-btn.copied {
    color: theme("colors.neon.emerald");
    border-color: theme("colors.neon.emerald");
    box-shadow: none;
    translate: 0 0;
    opacity: 1;
  }

  .copy-code-btn.error {
    color: theme("colors.red.400");
    border-color: theme("colors.red.400");
    box-shadow: none;
    translate: 0 0;
    opacity: 1;
  }
</style>

<script>
  document.querySelectorAll("pre").forEach((pre) => {
    pre.style.position = "relative";

    const clipboardIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>`;
    const clipboardCheckIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>`;
    const clipboardXIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m15 11-6 6"/><path d="m9 11 6 6"/></svg>`;

    const button = document.createElement("button");
    button.className = "copy-code-btn";
    button.setAttribute("aria-label", "Copy code");
    button.innerHTML = clipboardIcon;

    button.addEventListener("click", async (_event) => {
      const code = pre.querySelector("code");
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code.innerText);

        button.innerHTML = clipboardCheckIcon;
        button.classList.add("copied");

        setTimeout(() => {
          button.innerHTML = clipboardIcon;
          button.classList.remove("copied");
        }, 2000);
      } catch {
        button.innerHTML = clipboardXIcon;
        button.classList.add("error");

        setTimeout(() => {
          button.innerHTML = clipboardIcon;
          button.classList.remove("error");
        }, 2000);
      }
    });

    pre.appendChild(button);
  });
</script>

---
import { DECORATION_SIZE, cardDecoration } from "@/lib/cardDecoration";

// An article's corner shapes (the same ones its card shows), drawn in Astro.
// They drift slowly and scatter when the parent is hovered, in CSS only (see
// the <style> below). Place it as the first child of a
// `relative` element.
interface Props {
  /** Article id; seeds the shapes. */
  id: string;
  stroke: string;
}

const { id, stroke } = Astro.props;

const shapes = cardDecoration(id).map(({ element, fill, offset }, i) => ({
  element,
  fill,
  style: [
    // Hover scatter.
    `--dx: ${offset.dx.toFixed(1)}px`,
    `--dy: ${offset.dy.toFixed(1)}px`,
    // Idle drift: perpendicular to the scatter, on staggered loops.
    `--fx: ${(-offset.dy * 0.6).toFixed(1)}px`,
    `--fy: ${(offset.dx * 0.6).toFixed(1)}px`,
    `--float-duration: ${5 + i * 1.3}s`,
    `--float-delay: ${-i * 1.7}s`,
  ].join("; "),
}));
---

<svg
  class="shape-decoration pointer-events-none absolute bottom-0 right-0 select-none"
  width={DECORATION_SIZE}
  height={DECORATION_SIZE}
  viewBox={`0 0 ${DECORATION_SIZE} ${DECORATION_SIZE}`}
  overflow="visible"
  aria-hidden="true"
>
  {shapes.map(({ element: { tag: Shape, attrs }, fill, style }) => (
    <g class="shape" style={style}>
      <Shape {...attrs} fill={fill} stroke={stroke} stroke-width="2" />
    </g>
  ))}
</svg>

<style>
  /* ShapeDecoration.astro: shapes drift slowly on their own loops and scatter
     when the parent is hovered or focused, like the article cards. */
  .shape-decoration .shape {
    transition: transform 0.3s ease;
  }

  :global(:hover) > .shape-decoration .shape,
  :global(:focus-visible) > .shape-decoration .shape {
    transform: translate(var(--dx), var(--dy));
  }

  @media (prefers-reduced-motion: no-preference) {
    .shape-decoration .shape {
      animation: shape-float var(--float-duration) ease-in-out
        var(--float-delay) infinite alternate;
    }
  }

  @keyframes shape-float {
    to {
      translate: var(--fx) var(--fy);
    }
  }
</style>

---
interface Props {
  title: string;
  /** Rendered as a square-bullet list; otherwise the slot is used. */
  items?: string[];
}

const { title, items } = Astro.props;
---

<section class="mt-12">
  <h2 class="text-2xl font-bold text-neon-pink">{title}</h2>
  <div class="mt-4 text-neutral-300">
    {items ? (
      <ul class="list-[square] space-y-2 pl-5 marker:text-neon-pink">
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : (
      <slot />
    )}
  </div>
</section>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import ArticleSearch from "@/components/react/ArticleSearch";
import { getCollection } from "astro:content";
import { toSlug } from "@/lib/slug";

const articles = await getCollection("articles", ({ data }) => !data.draft);
const sorted = articles.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const articleData = sorted.map((a) => ({
  id: toSlug(a.id),
  title: a.data.title,
  excerpt: a.data.excerpt,
  date: a.data.date.toISOString(),
  tags: a.data.tags,
}));
const topicCount = new Set(articles.flatMap((a) => a.data.tags)).size;
---

<BaseLayout title="Articles - Andrew Gilliland">
  <Container class="min-h-screen pb-14">
    <PageHeader
      title="Articles"
      eyebrow={`Writing · ${articles.length} articles · ${topicCount} topics`}
    />
    <ArticleSearch articles={articleData} client:load />
  </Container>
</BaseLayout>

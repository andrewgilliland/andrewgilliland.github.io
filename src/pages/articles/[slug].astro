---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BackLink from "@/components/BackLink.astro";
import ColorDivider from "@/components/ColorDivider.astro";
import Container from "@/components/Container.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import RelatedArticlesSection from "@/components/articles/RelatedArticlesSection.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import MobileTOC from "@/components/MobileTOC.astro";
import ProgressBar from "@/components/ProgressBar.astro";
import Tag from "@/components/Tag.astro";
import CopyCodeButton from "@/components/CopyCodeButton.astro";
import { getCollection, render } from "astro:content";
import { getRelatedArticles } from "@/lib/relatedArticles";
import { toSlug } from "@/lib/slug";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: toSlug(article.id) },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const hasHeadings = headings.some((h) => h.depth >= 2 && h.depth <= 3);

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const relatedArticles = getRelatedArticles(article, allArticles, 3);
---

<BaseLayout
  title={`${article.data.title} - Andrew Gilliland`}
  description={article.data.excerpt}
  type="article"
  publishedTime={article.data.date.toISOString()}
>
  <Container class="min-h-screen py-14">
    <div
      class:list={[
        hasHeadings && "lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12",
      ]}
    >
      <div class="mx-auto min-w-0 max-w-prose">
        <BackLink href="/articles" label="Back to Articles" />
        <header class="mt-10">
          <p
            class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400"
          >
            Article · <FormattedDate date={article.data.date} />
          </p>
          <h1
            class="mt-4 text-4xl font-bold leading-tight text-neutral-50 md:text-5xl"
          >
            {article.data.title}
          </h1>
          {
            article.data.tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2.5">
                {article.data.tags.map((tag) => (
                  <Tag tag={tag} />
                ))}
              </div>
            )
          }
          <ColorDivider
            className="mt-8 h-4 w-full border-2 border-neutral-50"
          />
        </header>
        <article class="article-body prose prose-invert py-12">
          <Content />
        </article>
        <RelatedArticlesSection articles={relatedArticles} />
      </div>
      {
        hasHeadings && (
          <aside class="hidden lg:block">
            <div class="sticky top-10 pt-24">
              <TableOfContents headings={headings} />
            </div>
          </aside>
        )
      }
    </div>
  </Container>
  {hasHeadings && <MobileTOC headings={headings} />}
  <ProgressBar />
  <CopyCodeButton />
</BaseLayout>

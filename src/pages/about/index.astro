---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BentoTile from "@/components/home/BentoTile.astro";
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import gusImg from "@/images/gus-christmas-1.jpeg";
import hankImg from "@/images/hank-kitchen-1.jpeg";
import hannahAndrewImg from "@/images/hannah-andrew-1.jpeg";
import bernieImg from "@/images/bernie-kitchen-1.jpeg";

const techGroups = [
  {
    title: "Web Fundamentals",
    items: ["HTML5", "CSS3", "JavaScript", "TypeScript", "React", "Node.js"],
  },
  {
    title: "Cloud & Hosting",
    items: ["AWS", "Vercel", "Cloudflare", "Netlify", "Fly.io"],
  },
  {
    title: "Databases",
    items: ["MySQL", "PostgreSQL", "SQLite", "DynamoDB", "MongoDB"],
  },
  {
    title: "Apple Ecosystem",
    items: ["Swift", "UIKit", "SwiftUI", "CoreML", "ARKit", "RealityKit"],
  },
];
const techShadows = ["pink", "emerald", "yellow", "cyan"] as const;
// Full class names so Tailwind can see them.
const markers = [
  "marker:text-neon-pink",
  "marker:text-neon-emerald",
  "marker:text-neon-yellow",
  "marker:text-neon-cyan",
];

const photo =
  "relative overflow-hidden border-2 border-neutral-50 aspect-[4/5] md:aspect-auto";
const photoImg = "h-full w-full object-cover";
const caption =
  "absolute bottom-3 left-3 border-2 border-neutral-950 px-2.5 py-1 font-mono text-sm font-semibold text-neutral-950";
---

<BaseLayout title="About - Andrew Gilliland">
  <Container class="min-h-screen pb-14">
    <PageHeader title="About" eyebrow="Software engineer · Bloomington, IL" />

    <div class="grid auto-rows-[minmax(10rem,auto)] grid-cols-2 gap-6 md:grid-cols-4">
      <BentoTile shadow="cyan" fill="pink" class="col-span-2 justify-center">
        <h2 class="text-4xl font-bold leading-none md:text-5xl">
          Developer.
          <br />
          Builder.
          <br />
          Learner.
        </h2>
      </BentoTile>

      <figure
        class={`${photo} shadow-[8px_8px_0_0_theme(colors.neon.yellow)] md:row-span-2`}
      >
        <Image
          class={photoImg}
          src={gusImg}
          width={1128}
          height={1410}
          alt="Gus the Cat"
        />
        <figcaption class={`${caption} bg-neon-yellow`}>Gus</figcaption>
      </figure>

      <figure
        class={`${photo} shadow-[8px_8px_0_0_theme(colors.neon.emerald)] md:row-span-2`}
      >
        <Image
          class={photoImg}
          src={hankImg}
          width={1128}
          height={1410}
          alt="Hank the Dog"
        />
        <figcaption class={`${caption} bg-neon-emerald`}>Hank</figcaption>
      </figure>

      <BentoTile shadow="emerald" class="col-span-2 justify-center">
        <p class="text-lg leading-relaxed text-neutral-200">
          Community-taught software engineer who learned everything the hard
          way, one Stack Overflow rabbit hole at a time. He loves digging into
          new ideas, untangling hard problems, and making things that actually
          ship. When he&apos;s not pushing commits, he&apos;s organizing meetups
          for{" "}
          <a
            class="font-semibold text-neon-emerald underline decoration-2 underline-offset-4 hover:text-neon-cyan"
            href="https://www.blono.dev/"
          >
            Bloomington-Normal Developers
          </a>
          , because talking about code is almost as fun as writing it.
        </p>
      </BentoTile>

      <figure class={`${photo} shadow-[8px_8px_0_0_theme(colors.neon.pink)]`}>
        <Image
          class={photoImg}
          src={hannahAndrewImg}
          width={496}
          height={620}
          alt="Hannah and Andrew"
        />
      </figure>

      <figure class={`${photo} shadow-[8px_8px_0_0_theme(colors.neon.cyan)]`}>
        <Image
          class={photoImg}
          src={bernieImg}
          width={496}
          height={620}
          alt="Bernie the Cat"
        />
        <figcaption class={`${caption} bg-neon-cyan`}>Bernie</figcaption>
      </figure>

      <BentoTile shadow="pink" fill="cyan" class="col-span-2 justify-center">
        <h2 class="text-4xl font-bold leading-none md:text-5xl">
          Cats, code,
          <br />
          and Yacht Rock.
        </h2>
      </BentoTile>

      <BentoTile
        shadow="yellow"
        class="col-span-2 justify-center md:col-span-3"
      >
        <p class="text-lg leading-relaxed text-neutral-200">
          Away from the keyboard he&apos;s usually grilling something, building
          something out of wood, or pretending his home projects have a
          deadline. Downtime means hanging with his fiancé Hannah, a dog named
          Hank who thinks he&apos;s a person, and two cats, Gus and Bernie, who
          are definitely in charge. Soundtrack: strictly Yacht Rock.
        </p>
      </BentoTile>

      <BentoTile
        href="/about/resume"
        shadow="pink"
        fill="yellow"
        class="col-span-2 justify-between md:col-span-1"
      >
        <span class="font-mono text-xs uppercase tracking-[0.2em]">
          Experience
        </span>
        <span class="mt-6 flex items-center justify-between gap-3">
          <span class="text-3xl font-bold">Resume</span>
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </span>
      </BentoTile>

      {techGroups.map((group, index) => (
        <BentoTile
          shadow={techShadows[index % techShadows.length]}
          class="col-span-2 lg:col-span-1"
        >
          <h2 class="text-xl font-bold">{group.title}</h2>
          <ul
            class={`mt-4 list-[square] space-y-1.5 pl-5 text-neutral-300 ${markers[index % markers.length]}`}
          >
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </BentoTile>
      ))}
    </div>
  </Container>
</BaseLayout>
